# Use gitstatus's asynchronous results while keeping compact Git indicators.
_p10k_git_formatter () {
  emulate -L zsh
  if [[ -n $P9K_CONTENT ]]; then
    typeset -g _p10k_git_format=$P9K_CONTENT
    return
  fi

  local branch=${(V)VCS_STATUS_LOCAL_BRANCH}
  if [[ -n $branch ]]; then
    typeset -g _p10k_git_format="%fon %B%F{magenta} ${branch//\%/%%}%b"
  elif [[ -n $VCS_STATUS_COMMIT ]]; then
    typeset -g _p10k_git_format="%B%F{green}(${VCS_STATUS_COMMIT[1,7]})%b"
  else
    typeset -g _p10k_git_format=
    return
  fi
  [[ -z $VCS_STATUS_ACTION ]] || _p10k_git_format+=" %B%F{yellow}(${(U)VCS_STATUS_ACTION})%b"

  local changes=
  (( VCS_STATUS_NUM_CONFLICTED )) && changes+='='
  (( VCS_STATUS_STASHES )) && changes+='$'
  # shortcut: gitstatus groups renames as add/delete; use porcelain if exact rename symbols are needed.
  (( VCS_STATUS_NUM_STAGED_DELETED || VCS_STATUS_NUM_UNSTAGED_DELETED )) && changes+='✘'
  (( VCS_STATUS_NUM_UNSTAGED > VCS_STATUS_NUM_UNSTAGED_DELETED )) && changes+='!'
  (( VCS_STATUS_NUM_STAGED > VCS_STATUS_NUM_STAGED_DELETED )) && changes+='+'
  (( VCS_STATUS_NUM_UNTRACKED )) && changes+='?'
  if (( VCS_STATUS_COMMITS_AHEAD && VCS_STATUS_COMMITS_BEHIND )); then
    changes+='⇕'
  elif (( VCS_STATUS_COMMITS_AHEAD )); then
    changes+='⇡'
  elif (( VCS_STATUS_COMMITS_BEHIND )); then
    changes+='⇣'
  fi
  [[ -z $changes ]] || _p10k_git_format+=" %B%F{red}[$changes]%b"
  return 0
}
functions -M _p10k_git_formatter
typeset -g POWERLEVEL9K_VCS_DISABLE_GITSTATUS_FORMATTING=true
typeset -g POWERLEVEL9K_VCS_CONTENT_EXPANSION='${$((_p10k_git_formatter()))+${_p10k_git_format}}'
